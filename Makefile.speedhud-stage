# DuoFace Native12 Speed HUD source-only compile; no packaging or Sileo.
TARGET := iphone:clang:latest:15.0
ARCHS := arm64
THEOS_PACKAGE_SCHEME := rootless
INSTALL_TARGET_PROCESSES := SpringBoard
include $(THEOS)/makefiles/common.mk
TWEAK_NAME := DuoFaceSpeedHUD
DuoFaceSpeedHUD_FILES := runtime/speedbubble/DFSpeedBubbleBridge.mm runtime/speedbubble/DFSpeedTransport.mm runtime/speedbubble/DFSpeedGMapReader.mm
DuoFaceSpeedHUD_CFLAGS := -DDF_SPEED_HUD_SPRINGBOARD=1 -fobjc-arc -fblocks -Wall -Wextra -Werror
DuoFaceSpeedHUD_CCFLAGS := -std=c++17
DuoFaceSpeedHUD_FRAMEWORKS := UIKit Foundation
# iPhoneOS: notify(3) symbols are supplied by libSystem; -lnotify is absent.
include $(THEOS_MAKE_PATH)/tweak.mk
