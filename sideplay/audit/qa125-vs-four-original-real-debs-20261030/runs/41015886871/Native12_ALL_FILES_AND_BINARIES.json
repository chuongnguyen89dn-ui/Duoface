    "postinst": {
      "sha256": "76f77789739b1bb9f2a00f8b3b5a45e946ebf0b34b090de49bf7b84daef4452a",
      "text": "#!/bin/sh\nset -eu\nif command -v uicache >/dev/null 2>&1; then uicache -a || true; fi\necho \"DuoFace Native TEST installed. Restart SpringBoard/CarPlay before device testing.\"\nexit 0\n"
    },
    "preinst": {
      "sha256": "c04ed0e312987fe7b250647014d5b59bad413d0b24a20537dba87a6fb709b45c",
      "text": "#!/bin/sh\nset -eu\nfor protected in     /var/jb/Applications/DuoFaceUI.app/DuoFaceUI     /var/jb/Library/MobileSubstrate/DynamicLibraries/DuoFaceDashboard.dylib     /var/jb/Library/MobileSubstrate/DynamicLibraries/DuoFaceFullscreenBridge.dylib     /var/jb/Library/MobileSubstrate/DynamicLibraries/DuoFaceVisualHook.dylib\ndo\n    owner=\"$(dpkg-query -S \"$protected\" 2>/dev/null || true)\"\n    if [ -n \"$owner\" ]; then\n        case \"$owner\" in\n            \"com.duoface.independent\":* ) ;;\n            *)\n                echo \"DuoFace native3: another installed package owns $protected; refusing overwrite\" >&2\n                exit 1\n                ;;\n        esac\n    fi\ndone\nexit 0\n"
    },
    "prerm": {
      "sha256": "306c6ca7407560340797866e077e053627ad409277d1b9da58106fce4cf717cb",
      "text": "#!/bin/sh\nexit 0\n"
