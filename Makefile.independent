TARGET := iphone:clang:latest:15.0
ARCHS := arm64
THEOS_PACKAGE_SCHEME := rootless
INSTALL_TARGET_PROCESSES := SpringBoard
include $(THEOS)/makefiles/common.mk

TWEAK_NAME := DuoFaceIndependentProbe
DuoFaceIndependentProbe_FILES := independent/DFIProbe.mm independent/DFISplitLayout.mm
DuoFaceIndependentProbe_CFLAGS := -fobjc-arc -fblocks -Wall -Wextra
DuoFaceIndependentProbe_FRAMEWORKS := UIKit Foundation

include $(THEOS_MAKE_PATH)/tweak.mk
