# Native12 Speed5 isolated high scene UIWindow in SpringBoard; no CarPlayApp or Waze injection.
TARGET := iphone:clang:latest:15.0
ARCHS := arm64
THEOS_PACKAGE_SCHEME := rootless
INSTALL_TARGET_PROCESSES := SpringBoard
include $(THEOS)/makefiles/common.mk
TWEAK_NAME := DuoFaceSpeedHUD
DuoFaceSpeedHUD_FILES := runtime/speedbubble/DFSpeedSceneOverlay.mm runtime/speedbubble/DFSpeedTransport.mm
DuoFaceSpeedHUD_CFLAGS := -fobjc-arc -fblocks -Wall -Wextra -Werror
DuoFaceSpeedHUD_CCFLAGS := -std=c++17
DuoFaceSpeedHUD_FRAMEWORKS := UIKit Foundation
include $(THEOS_MAKE_PATH)/tweak.mk
