#!/bin/sh
# Register a real iPhone Home screen app, but DO NOT respring or auto-enable QA.
set -eu
case "${1:-}" in configure) ;; *) exit 0;; esac
for CACHE in /var/jb/usr/bin/uicache /usr/bin/uicache; do
  if [ -x "$CACHE" ]; then "$CACHE" -p /var/jb/Applications/DuoFaceTest.app || true;break;fi
done
echo 'DuoFace Test app icon registered; no opt-in was enabled by installation.'
