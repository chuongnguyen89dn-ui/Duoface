# SpringBoard in-place DuoFace Native12 HUD; no global window or Waze hooks
TARGET := iphone:clang:latest:15.0
ARCHS := arm64
THEOS_PACKAGE_SCHEME := rootless
INSTALL_TARGET_PROCESSES := SpringBoard
include $(THEOS)/makefiles/common.mk
TWEAK_NAME := DuoFaceSpeedHUD
DuoFaceSpeedHUD_FILES := runtime/speedbubble/DFSpeedNativeSplit9TrustedSourcesSpringBoard.mm runtime/speedbubble/DFSpeedTransport9.mm runtime/speedbubble/DFSpeedGMapReader9.mm runtime/speedbubble/DFSpeedInstalledSourceCatalog9.mm
DuoFaceSpeedHUD_CFLAGS := -DDF_SPEED_HUD_SPRINGBOARD=1 -fobjc-arc -fblocks -Wall -Wextra -Werror
DuoFaceSpeedHUD_CCFLAGS := -std=c++17
DuoFaceSpeedHUD_FRAMEWORKS := UIKit Foundation
include $(THEOS_MAKE_PATH)/tweak.mk
