#!/bin/sh
# ============================================================================
# cboptimize - DuoFace System Optimizer CLI Tool
# Installed automatically with DuoFace for iOS
# ============================================================================

ACTION="${1:-status}"

LAUNCHCTL_BIN="/var/jb/usr/bin/launchctl"
[ -x "$LAUNCHCTL_BIN" ] || LAUNCHCTL_BIN="/usr/bin/launchctl"

SERVICES="com.apple.ReportCrash com.apple.ReportCrash.SimulateCrash com.apple.AggregateDictionary.addaily com.apple.symptomsd-diag com.apple.healthd com.apple.healthrecordsd com.apple.OTATaskingAgent com.apple.softwareupdated com.apple.triald com.apple.biomesyncd com.apple.routined com.apple.duetexpertd"

case "$ACTION" in
    status)
        echo "=========================================================="
        echo "  DuoFace System Status"
        echo "=========================================================="
        echo "--- Load Average & Uptime ---"
        uptime
        echo ""
        echo "--- Memory Overview ---"
        vm_stat
        echo ""
        if [ -x "$LAUNCHCTL_BIN" ]; then
            echo "--- Disabled Daemons in Launchd ---"
            "$LAUNCHCTL_BIN" print-disabled system 2>/dev/null || true
        fi
        ;;

    optimize)
        echo "=========================================================="
        echo "  Applying System-Wide Performance Optimizations..."
        echo "=========================================================="
        if [ -x "$LAUNCHCTL_BIN" ]; then
            for svc in $SERVICES; do
                echo "[-] Disabling: $svc"
                "$LAUNCHCTL_BIN" disable "system/$svc" 2>/dev/null || true
                "$LAUNCHCTL_BIN" kill SIGKILL "system/$svc" 2>/dev/null || true
            done
        fi
        echo "[-] Purging stale crash logs & debug buffers..."
        rm -rf /var/mobile/Library/Logs/CrashReporter/* 2>/dev/null || true
        rm -rf /Library/Logs/CrashReporter/* 2>/dev/null || true
        for logfile in /var/mobile/duoface.log /var/mobile/duoface_live.log /var/mobile/carbridge.log /var/mobile/carbridge_live.log; do
            [ -f "$logfile" ] && > "$logfile" || true
        done
        echo "==> Optimization complete! CPU and RAM released."
        ;;

    restore)
        echo "=========================================================="
        echo "  Restoring System Daemons to Default..."
        echo "=========================================================="
        if [ -x "$LAUNCHCTL_BIN" ]; then
            for svc in $SERVICES; do
                echo "[+] Enabling: $svc"
                "$LAUNCHCTL_BIN" enable "system/$svc" 2>/dev/null || true
            done
        fi
        echo "==> All daemons restored to default state."
        ;;

    clean-logs)
        echo "[-] Cleaning crash logs and debug traces..."
        rm -rf /var/mobile/Library/Logs/CrashReporter/* 2>/dev/null || true
        rm -rf /Library/Logs/CrashReporter/* 2>/dev/null || true
        for logfile in /var/mobile/duoface.log /var/mobile/duoface_live.log /var/mobile/carbridge.log /var/mobile/carbridge_live.log; do
            [ -f "$logfile" ] && > "$logfile" || true
        done
        echo "==> Clean completed."
        ;;

    *)
        echo "Usage: cboptimize {status|optimize|restore|clean-logs}"
        exit 1
        ;;
esac

exit 0
