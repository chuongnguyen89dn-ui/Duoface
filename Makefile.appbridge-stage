# Source-level compile-only CarPlay Add App extension; no DEB packaging.
TARGET := iphone:clang:latest:15.0
ARCHS := arm64
THEOS_PACKAGE_SCHEME := rootless
INSTALL_TARGET_PROCESSES := SpringBoard
include $(THEOS)/makefiles/common.mk
TWEAK_NAME := DuoFaceInCarAddApps
DuoFaceInCarAddApps_FILES := runtime/appbridge/DFInCarAppPicker.xm
DuoFaceInCarAddApps_CFLAGS := -fobjc-arc -fblocks -Wall -Wextra -Werror
DuoFaceInCarAddApps_FRAMEWORKS := Foundation UIKit
include $(THEOS_MAKE_PATH)/tweak.mk
