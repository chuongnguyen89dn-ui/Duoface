  "binary_count": 8,
  "control": {
    "control": {
      "sha256": "b3ef47ef2d8fabec04f57b52be8990504006b48e7ba2d6b2f732c4ff35935dc4",
      "text": "Package: com.duoface.jb.embedded\nName: DuoFace Independent (Integrated CarPlay Beta)\nVersion: 0.0.125~lockabi1\nArchitecture: iphoneos-arm64\nSection: Applications\nPriority: optional\nMaintainer: DuoFace Independent\nDepends: firmware (>= 16.0), mobilesubstrate\nConflicts: com.duoface.mytweak.v1a.preflight, com.duoface.carplay.nativebridgeqa, com.duoface.carplay.firstpartyadmission, com.duoface.carplay.nativescenehost, com.duoface.qa.controlapp, com.duoface.independent, com.duoface.sideplaydisplay, com.duonavi.app, com.duoface.app\nReplaces: com.duoface.mytweak.v1a.preflight, com.duoface.carplay.nativebridgeqa, com.duoface.carplay.firstpartyadmission, com.duoface.carplay.nativescenehost, com.duoface.qa.controlapp\nDescription: Independent rootless iOS16 CarPlay DuoFace beta in one DEB with integrated app bridge, scene host and DuoFace UI; no separate CarBridge required. Native12-inspired controls include app picker, split, logo move, swap and zoom. CarPlay hardware behavior and media playback are not yet verified. Replaces conflicting older first-party DuoFace QA modules; review changes before installation.\n"
    },
    "postinst": {
      "sha256": "6d2ff6887cad7125c977d899bda63383d03a21c3059e80306051b0535a9af7c1",
      "text": "#!/bin/sh\nset -eu\ncase \"${1:-}\" in configure) ;; *) exit 0 ;; esac\n# Only register the single independent DuoFace UI bundle. No process restart, no\n# preference changes, no CarPlay allowance, no vendor library registration.\nfor APP in /var/jb/Applications/DuoFaceNativeHost.app; do\n  [ -d \"$APP\" ] || { echo \"DuoFace integrated: app missing $APP\" >&2; exit 1; }\n  FOUND=0\n  for CACHE in /var/jb/usr/bin/uicache /usr/bin/uicache; do\n    if [ -x \"$CACHE\" ]; then\n      FOUND=1\n      \"$CACHE\" -p \"$APP\" || echo \"DuoFace integrated: uicache failed for $APP\" >&2\n      break\n    fi\n  done\n  [ \"$FOUND\" = 1 ] || echo \"DuoFace integrated: uicache absent, icon unconfirmed $APP\" >&2\ndone\nexit 0\n"
    },
    "postrm": {
      "sha256": "b3e2e6d2ec27254316a0840ba509bcaf6df1c7a2583b15c948745b3b656d1c04",
      "text": "#!/bin/sh\nset -eu\ncase \"${1:-}\" in remove) ;; *) exit 0 ;; esac\nfor APP in /var/jb/Applications/DuoFaceNativeHost.app; do\n  for CACHE in /var/jb/usr/bin/uicache /usr/bin/uicache; do\n    if [ -x \"$CACHE\" ]; then \"$CACHE\" -u \"$APP\" || true; break; fi\n  done\ndone\nexit 0\n"
    }
  },
