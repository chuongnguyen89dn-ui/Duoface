# Independent rootless diagnostic: produces DuoFaceDiagnostic.dylib only.
TARGET := iphone:clang:latest:15.0
ARCHS := arm64
THEOS_PACKAGE_SCHEME := rootless
INSTALL_TARGET_PROCESSES := SpringBoard
include $(THEOS)/makefiles/common.mk
TWEAK_NAME := DuoFaceDiagnostic
DuoFaceDiagnostic_FILES := runtime/speedbubble/DFSpeedDiagnosticSpringBoard.mm
DuoFaceDiagnostic_CFLAGS := -fobjc-arc -fblocks -Wall -Wextra -Werror
DuoFaceDiagnostic_FRAMEWORKS := UIKit Foundation
include $(THEOS_MAKE_PATH)/tweak.mk
