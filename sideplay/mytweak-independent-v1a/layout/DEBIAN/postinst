#!/bin/sh
# Register our own new rootless app with the normal iOS app icon cache.
APP=/var/jb/Applications/MTDuoFaceShell.app
if [ -d "$APP" ]; then
  if [ -x /var/jb/usr/bin/uicache ]; then
    /var/jb/usr/bin/uicache -p "$APP" >/dev/null 2>&1 || true
  elif command -v uicache >/dev/null 2>&1; then
    uicache -p "$APP" >/dev/null 2>&1 || true
  fi
fi
exit 0
